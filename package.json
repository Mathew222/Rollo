{
  "name": "rollo-expense-tracker",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"python backend/server.py\" \"npm --prefix frontend run dev\"",
    "dev:backend": "python backend/server.py",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "test": "python backend/test_server.py",
    "test:backend": "python backend/test_server.py",
    "install:frontend": "npm --prefix frontend install",
    "install:backend": "pip install -r backend/requirements.txt"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
